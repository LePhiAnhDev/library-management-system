# Copy to backend/.env and fill in real values. In this private repo the real .env is committed
# on purpose (see spec section 4); this example documents the variable names.

# --- PostgreSQL (container credentials + app datasource) ---
POSTGRES_USER=library_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=library
DB_HOST=localhost
DB_PORT=5433

# --- Spring profile + server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Auth (Clerk) ---
CLERK_ISSUER_URI=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URI=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- CORS: frontend origins allowed to call the API ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudflare R2 (object storage for book cover images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PUBLIC_DEV_URL=
R2_PRESIGNED_URL_EXPIRE_SECONDS=3600
