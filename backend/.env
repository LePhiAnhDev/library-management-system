# --- PostgreSQL (container credentials + app datasource) ---
POSTGRES_USER=library_user
POSTGRES_PASSWORD=library_password
POSTGRES_DB=library
DB_HOST=localhost
DB_PORT=5433

# --- Spring profile + server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Auth (Clerk) ---
# Backend validates Clerk session JWT as an OAuth2 Resource Server.
# Issuer is the Clerk Frontend API origin (decoded from the publishable key domain).
CLERK_ISSUER_URI=https://just-drake-18.clerk.accounts.dev
CLERK_JWKS_URI=https://just-drake-18.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_bOEmro1rs86GVfke6kRY25qtSQhQDiwwpy5QpCiVGZ
CLERK_PUBLISHABLE_KEY=pk_test_anVzdC1kcmFrZS0xOC5jbGVyay5hY2NvdW50cy5kZXYk

# --- CORS: frontend origins allowed to call the API ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

