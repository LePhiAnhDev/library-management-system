# Production environment for the backend (baked into the Docker image as ./.env,
# and also loaded by docker-compose.prod.yml via env_file). Committed on purpose
# to a PRIVATE repo to simplify the deploy pipeline (accepted risk). If the repo
# ever goes public, rotate every secret below first.

# --- PostgreSQL (container credentials + app datasource) ---
# Both the postgres service and the backend read these from this same file,
# so the values must stay in sync. Host = compose service name "postgres".
POSTGRES_USER=library_user
# TODO: đặt mật khẩu DB production mạnh (chỉ dùng nội bộ trong Docker network).
POSTGRES_PASSWORD=library_prod_change_me
POSTGRES_DB=library
DB_HOST=postgres
DB_PORT=5432

# --- Spring profile + server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Auth (Clerk) ---
# !!! TODO (BẮT BUỘC trước khi go-live): tạo Clerk PRODUCTION instance cho drx.io.vn,
# cấu hình DNS (CNAME clerk/accounts/... theo hướng dẫn Clerk), rồi thay 4 giá trị dưới
# bằng issuer/jwks của production + pk_live/sk_live. Khóa test dưới đây chỉ để image build
# và chạy thử được; instance test có giới hạn và không phục vụ đúng trên custom domain.
CLERK_ISSUER_URI=https://just-drake-18.clerk.accounts.dev
CLERK_JWKS_URI=https://just-drake-18.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_bOEmro1rs86GVfke6kRY25qtSQhQDiwwpy5QpCiVGZ
CLERK_PUBLISHABLE_KEY=pk_test_anVzdC1kcmFrZS0xOC5jbGVyay5hY2NvdW50cy5kZXYk

# --- CORS: chỉ cho phép frontend production ---
APP_CORS_ALLOWED_ORIGINS=https://drx.io.vn

# --- Cloudflare R2 (object storage for book cover images) ---
# Dùng lại bucket R2 thật hiện có (public access đã bật). Có thể tạo bucket riêng cho
# production nếu muốn tách biệt dữ liệu dev/prod.
R2_ACCOUNT_ID=ac1f4da1827782b86f2acf7087595ae2
R2_ACCESS_KEY_ID=58fd1ed0250066ca7a840672e1401600
R2_SECRET_ACCESS_KEY=80caa962b2d578818d64c5ade8b2648f1f9c8cfb53526391d4fc08de40623c3c
R2_BUCKET_NAME=library-management-system
R2_REGION=auto
R2_PUBLIC_DEV_URL=https://pub-74f1e2e2aeb245ae8b3c11856bf83baa.r2.dev
R2_PRESIGNED_URL_EXPIRE_SECONDS=3600
